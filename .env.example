# Copy to .env.local and fill in. Never commit real values (.env* is gitignored; this file is the exception).

# Database (Neon Postgres or any Postgres)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Text models: GMI Cloud first, then the Vercel AI Gateway (one of these is enough)
GMI_API_KEY=
AI_GATEWAY_API_KEY=

# Sign-in (Neon Auth)
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Server secrets (any long random strings)
IP_SALT=
SAFETY_HASH_KEY=
CRON_SECRET=
ADMIN_KEY=

# Optional: Agent Village partner API, App Review demo sign-ups
VILLAGE_PARTNER_KEY=
VILLAGE_POPUP_ID=
DEMO_SIGNUP_KEY=

# Optional: photos (Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# Optional: Kismet by text (WhatsApp Cloud API)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=

# Optional: one Daytona sandbox per agent
AGENT_BOXES=
DAYTONA_API_KEY=

SITE_URL=http://localhost:3000
